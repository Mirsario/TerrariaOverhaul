AmbienceTrack: {
	Sound: {
		SoundPath: "TerrariaOverhaul/Assets/Sounds/Ambience/RainHeavy"
		Type: Ambient
		Volume: 0.08
		IsLooped: true
	}

	Variables: {
		Volume: {
			Inputs: [ "RainWeather", "SurfaceAltitude" ]
			Operation: Multiply
		}
	}

	SoundIsWallOccluded: true
}
