ItemOverhauls: {
	Archery: {
		HoverShots:
			'''
			[[Flota en el aire]] al cargar un disparo mientras saltas
			Realiza un [[tiro flotante]] para ganar aún más velocidad
			'''
		ManualCharging:
			'''
			Mantén presionado el clic derecho para [[cargar manualmente]] un disparo
			Suelta el botón en cualquier momento para [[ajustar a medida]] la velocidad y el daño
			'''
	}

	Melee: {
		AirCombatInfo:
			'''
			¡[[Ataca a los enemigos en el aire]] para ganar velocidad, mantener tu altura, o para huir!
			¡Usa las teclas de movimiento durante el golpe para controlar la velocidad!
			'''
		PowerStrikeInfo: "¡Carga [[golpes potenciados]] con el botón de uso alternativo!"
		VelocityBasedDamageInfo:
			'''
			[[¡Mientras más rápido vayas, más fuerte golpeas!]]
			¡Combina tus ataques con impulsos y usa la gravedad a tu favor!
			'''

		Broadsword: {
			KillingBlow: "¡Golpe mortal!"
			KillingBlowInfo:
				'''
				Da un [[golpe mortal]] al [[acertar un golpe potenciado]] a los enemigos heridos,
				multiplicando el daño por [[x{0}]] cuando el golpe mataría al enemigo
				'''
		}
	}
}

CommonTooltips: {
	ShowCombatInfo: "[Mantén la tecla {Key} para mostrar información de combate]"
	CombatInfo: "[Información de combate]"
	RightClickAudioCuesToggle: "Presiona clic derecho en el ítem para activar/desactivar indicadores auditivos"
	RightClickAudioCuesEnabled: "Indicadores auditivos activados"
	RightClickAudioCuesDisabled: "Indicadores auditivos desactivados"

	CriticalDamage: {
		// Tooltip: "{0} critical strike damage"
		# These are (case insensitive) regular expressions used to replace '{...}% critical chance' lines with '+X% critical damage'.
		# If you aren't familiar with regex - please ask the developers for help!
		# Always provide a 'value' capture!
		
		// Expression: '''(?<value>[\d.]+)(?<sign>%)?(?<operation>[ ]+(?:increased|bonus|additional)+)?(?<misc>.+)?(?:critical|crit)[ ]+(?:strike[ ]+)?chance'''
		// Replacement: "${value}${sign}${operation}${misc}critical damage"
		# Do not alter unless necessary:
		ExpressionFallback: '''(?<value>[\d.]+)(?<sign>%)?(?<operation>[ ]+(?:increased|bonus|additional)+)?(?<misc>.+)?(?:critical|crit)[ ]+(?:strike[ ]+)?chance'''
		# Do not alter unless necessary:
		ReplacementFallback: "${value}${sign}${operation}${misc}critical damage"
	}

	GrapplingHooks: {
		ClassicPullTip: "Mantén presionada la tecla de gancho para una tracción clásica"
	}
}

