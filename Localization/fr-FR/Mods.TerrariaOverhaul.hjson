ItemOverhauls: {
	Archery: {
		HoverShots:
			'''
			[[Flotte dans les airs]] en chargeant l'arme pendant le saut
			Effectue un [[tir stationnaire]] pour gagner encore plus de vélocité
			'''
		ManualCharging:
			'''
			Garde pressé clic droit pour [[charger manuellement]] l'arme
			Relâche à tout moment pour [[affiner]] la vitesse et les dégâts du tir
			'''
	}

	Melee: {
		AirCombatInfo:
			'''
			[[Attaque les enemis en l'air]] pour gagner de la vitesse, rester en suspension, ou battre en retraite!
			Utilise les touches directionnelles pendant un coup pour contrôler la vélocité obtenue!
			'''
		PowerStrikeInfo: "Charge les [[Attaques Puissantes]] via des méthodes alternatives!"
		VelocityBasedDamageInfo:
			'''
			[[Plus vite ça bouge - plus dûr ça frappe!]]
			Combine les attaques avec des ruées et use même de la gravité pour gagner un avantage!
			'''

		Broadsword: {
			KillingBlow: "Coup Fatal!"
			KillingBlowInfo:
				'''
				Effectue un [[Coup Fatal]] en utilisant une [[attaque puissante]] sur des ennemis blessés,
				multipliant les dégâts par [[x{0}]] quand ça pourrait vaincre l'ennemi
				'''
		}
	}
}

CommonTooltips: {
	ShowCombatInfo: "[Presser {Key} pour afficher les informations de combat]"
	CombatInfo: "[Informations de Combat]"
	RightClickAudioCuesToggle: "Clic droit sur l'objet pour changer les indices sonores"
	RightClickAudioCuesEnabled: "Indices Sonores activés"
	RightClickAudioCuesDisabled: "Indices Sonores désactivés"

	CriticalDamage: {
		// Tooltip: "{0} critical strike damage"
		# These are (case insensitive) regular expressions used to replace '{...}% critical chance' lines with '+X% critical damage'.
		# If you aren't familiar with regex - please ask the developers for help!
		# Always provide a 'value' capture!
		
		// Expression: '''(?<value>[\d.]+)(?<sign>%)?(?<operation>[ ]+(?:increased|bonus|additional)+)?(?<misc>.+)?(?:critical|crit)[ ]+(?:strike[ ]+)?chance'''
		// Replacement: "${value}${sign}${operation}${misc}critical damage"
		# Do not alter unless necessary:
		ExpressionFallback: '''(?<value>[\d.]+)(?<sign>%)?(?<operation>[ ]+(?:increased|bonus|additional)+)?(?<misc>.+)?(?:critical|crit)[ ]+(?:strike[ ]+)?chance'''
		# Do not alter unless necessary:
		ReplacementFallback: "${value}${sign}${operation}${misc}critical damage"
	}

	GrapplingHooks: {
		ClassicPullTip: "Garder pressé la touche pour effectuer un lancer de grappin classique"
	}
}

