ItemOverhauls: {
	Archery: {
		HoverShots:
			'''
			[[Zawiśnij w Powietrzu]] ładując broń podczas skoku
			Wykonaj [[Strzał z Zawisu]] dla jeszcze większej prędkości
			'''
		ManualCharging:
			'''
			Przytrzymaj prawy przycisk myszy aby [[Manualnie Naładować]] swoją broń
			Puść w dowolnym momencie aby [[Dostroić]] prędkość i obrażenia strzału
			'''
	}

	Melee: {
		AirCombatInfo:
			'''
			[[Atakuj Przeciwników w Powietrzu]] by zystać prędkość, utrzymać wysokość, albo uciec!
			Użyj klawiszy ruchu podczas ataku by kontrolować zyskaną prędkość!
			'''
		PowerStrikeInfo: "Naładuj [[Wzmocniony Atak]] poprzez przycisk alternatywnego użycia!"
		VelocityBasedDamageInfo:
			'''
			[[I'm szybciej się poruszasz - tym mocniej uderzysz!]]
			Polącz ataki ze zrywem a nawet użyj grawitacji!
			'''

		Broadsword: {
			KillingBlow: "Zabójczy Cios!"
			KillingBlowInfo:
				'''
				Wykonaj [[Zabójcze Ciosy]] wykonując [[naładowany atak]] na rannych wrogach,
				mnożąc obrażenia o [[x{0}]] jeśli wykończyło by to wroga
				'''
		}
	}
}

CommonTooltips: {
	ShowCombatInfo: "[Przytrzymaj {Key} by pokazać informacje bojowe]"
	CombatInfo: "[Informacje Bojowe]"
	RightClickAudioCuesToggle: "Naciśnij prawym przyciskiem myszy na przedmiot aby przełączać wskazówki audio"
	RightClickAudioCuesEnabled: "Wskazówki audio są włączone"
	RightClickAudioCuesDisabled: "Wskazówki audio są wyłączone"

	CriticalDamage: {
		// Tooltip: "{0} critical strike damage"
		# These are (case insensitive) regular expressions used to replace '{...}% critical chance' lines with '+X% critical damage'.
		# If you aren't familiar with regex - please ask the developers for help!
		# Always provide a 'value' capture!
		
		// Expression: '''(?<value>[\d.]+)(?<sign>%)?(?<operation>[ ]+(?:increased|bonus|additional)+)?(?<misc>.+)?(?:critical|crit)[ ]+(?:strike[ ]+)?chance'''
		// Replacement: "${value}${sign}${operation}${misc}critical damage"
		# Do not alter unless necessary:
		ExpressionFallback: '''(?<value>[\d.]+)(?<sign>%)?(?<operation>[ ]+(?:increased|bonus|additional)+)?(?<misc>.+)?(?:critical|crit)[ ]+(?:strike[ ]+)?chance'''
		# Do not alter unless necessary:
		ReplacementFallback: "${value}${sign}${operation}${misc}critical damage"
	}

	GrapplingHooks: {
		ClassicPullTip: "Przytrzymaj klawisz haka dla klasycznego przyciągnięcia"
	}
}

